---
import { tracks } from "~/data/cv";
---

<section id="tracks" class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
  <div class="max-w-3xl">
    <p class="section-title">Areas I'd love to teach</p>
    <h2 class="mt-2 text-3xl sm:text-4xl font-semibold tracking-tight">
      Three tracks — with honest framing on each.
    </h2>
    <p class="mt-4 text-[color:var(--color-text-muted)] leading-relaxed">
      I won't claim mastery in areas where I'm still learning. For each track
      below I've tried to be specific about what I already teach confidently,
      what I'm actively studying, and what I'd bring as an instructor.
    </p>
  </div>

  <div class="mt-10 grid gap-5 md:grid-cols-3">
    {
      tracks.map((t) => (
        <article
          id={t.id}
          class="rounded-2xl border border-[color:var(--color-border)] bg-[color:var(--color-surface)]/70 p-6 backdrop-blur transition hover:border-[color:var(--color-accent-2)]/60 hover:bg-[color:var(--color-surface-2)]/70"
        >
          <div class="flex items-center gap-2">
            <span class="chip">{t.id.replace(/-/g, " ")}</span>
          </div>
          <h3 class="mt-4 text-xl font-semibold">{t.title}</h3>
          <p class="mt-1 text-sm text-[color:var(--color-accent)] leading-snug">
            {t.tagline}
          </p>
          <p class="mt-3 text-sm leading-relaxed text-[color:var(--color-text-muted)]">
            {t.summary}
          </p>
          <ul class="mt-4 space-y-1.5 text-sm">
            {t.bullets.map((b) => (
              <li class="flex gap-2">
                <span class="mt-1 inline-block size-1.5 shrink-0 rounded-full bg-[color:var(--color-accent-2)]" />
                <span>{b}</span>
              </li>
            ))}
          </ul>
          {t.repo && (
            <a
              href={t.repo}
              target="_blank"
              rel="noopener"
              class="mt-4 inline-flex items-center gap-1 text-xs font-mono text-[color:var(--color-accent-2)] hover:text-white transition break-all"
            >
              ↗ {t.repo.replace("https://", "")}
            </a>
          )}
        </article>
      ))
    }
  </div>
</section>
