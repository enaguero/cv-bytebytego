---
import { tracks } from "~/data/cv";
---

<section id="tracks" class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
  <div class="flex items-end justify-between gap-6">
    <div>
      <p class="section-title">Tracks I want to teach</p>
      <h2 class="mt-2 text-3xl sm:text-4xl font-bold tracking-tight">
        Three. Focused. Honest about each.
      </h2>
    </div>
    <p class="hidden sm:block max-w-md text-sm text-[color:var(--color-text-muted)]">
      Each card includes the angle I'd teach from and the receipts that back it up.
    </p>
  </div>

  <div class="mt-10 grid gap-5 md:grid-cols-3">
    {
      tracks.map((t) => (
        <article
          id={t.id}
          class="rounded-2xl border border-[color:var(--color-border)] bg-[color:var(--color-surface)]/70 p-6 backdrop-blur transition hover:border-[color:var(--color-accent-2)]/60 hover:bg-[color:var(--color-surface-2)]/70"
        >
          <div class="flex items-center gap-2">
            <span class="chip">{t.id.replace(/-/g, " ")}</span>
          </div>
          <h3 class="mt-4 text-xl font-semibold">{t.title}</h3>
          <p class="mt-1 text-sm text-[color:var(--color-accent)]">
            {t.tagline}
          </p>
          <p class="mt-3 text-sm leading-relaxed text-[color:var(--color-text-muted)]">
            {t.summary}
          </p>
          <ul class="mt-4 space-y-1.5 text-sm">
            {t.bullets.map((b) => (
              <li class="flex gap-2">
                <span class="mt-1 inline-block size-1.5 shrink-0 rounded-full bg-[color:var(--color-accent-2)]" />
                <span>{b}</span>
              </li>
            ))}
          </ul>
          <p class="mt-5 rounded-md bg-black/30 border border-[color:var(--color-border)] p-3 text-xs font-mono text-[color:var(--color-text-muted)]">
            <span class="text-[color:var(--color-accent)]">proof:</span> {t.proof}
          </p>
        </article>
      ))
    }
  </div>
</section>
