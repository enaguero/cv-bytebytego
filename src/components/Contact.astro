---
import { profile } from "~/data/cv";

const mailto = `mailto:${profile.email}?subject=${encodeURIComponent(
  "Hi Erwin",
)}`;
---

<section class="mx-auto max-w-6xl px-6 py-16 sm:py-24">
  <div class="rounded-3xl border border-[color:var(--color-border)] bg-gradient-to-br from-[color:var(--color-surface)]/80 to-[color:var(--color-surface-2)]/80 p-6 sm:p-14 text-center">
    <p class="section-title">Get in touch</p>
    <h2 class="mt-3 text-3xl sm:text-4xl font-semibold tracking-tight">
      If there's a fit, I'd love to talk.
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-[color:var(--color-text-muted)] leading-relaxed">
      Two to five hours bi-weekly fits well around my current senior engineering role.
      Happy to send a writing or teaching sample, do a short live walkthrough, or just
      have a conversation about what your learners need.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a class="cta-primary" href={mailto}>Email me · {profile.email}</a>
      <a class="cta-secondary" href={profile.linkedin} target="_blank" rel="noopener">
        LinkedIn · /in/{profile.handle}
      </a>
      <a class="cta-secondary" href={profile.github} target="_blank" rel="noopener">
        GitHub · @{profile.handle}
      </a>
    </div>
  </div>

  <footer class="mt-12 text-center text-xs text-[color:var(--color-text-muted)]">
    <p>© {new Date().getFullYear()} {profile.name}. Built openly with Astro, Tailwind &amp; Claude Code.</p>
  </footer>
</section>
