---
import { profile } from "~/data/cv";

const mailto = `mailto:jobs@bytebytego.com?cc=${encodeURIComponent(profile.email)}&subject=${encodeURIComponent(
  "Part-Time Instructor Application — Erwin Aguero",
)}&body=${encodeURIComponent(
  "Hi ByteByteGo team,\n\nI'd love to be considered for the part-time instructor role.\n\nTopics I'm excited to teach: System Design, Agentic AI Coding, AI Automation.\nLive CV (with AI demo): https://YOUR-DEPLOYED-URL\nTeaching repo: https://github.com/enaguero/4geeks_academy_spain_fs_pt_129\n\n— Erwin\n",
)}`;
---

<section class="mx-auto max-w-6xl px-6 py-16 sm:py-24">
  <div class="rounded-3xl border border-[color:var(--color-border)] bg-gradient-to-br from-[color:var(--color-surface)]/80 to-[color:var(--color-surface-2)]/80 p-10 sm:p-14 text-center glow-border">
    <p class="section-title">Let's talk</p>
    <h2 class="mt-3 text-3xl sm:text-5xl font-bold tracking-tight">
      Ready to teach <span class="text-[color:var(--color-accent)]">cohort one</span>.
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-[color:var(--color-text-muted)]">
      2–5 hours bi-weekly works for me. I can move fast on curriculum prep,
      demo a 30-minute teaching sample, and ship a live exercise the same day.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a class="cta-primary" href={mailto}>Email jobs@bytebytego.com</a>
      <a class="cta-secondary" href={profile.github} target="_blank" rel="noopener">
        GitHub · @{profile.handle}
      </a>
      <a class="cta-secondary" href={`mailto:${profile.email}`}>
        {profile.email}
      </a>
    </div>
  </div>

  <footer class="mt-12 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-[color:var(--color-text-muted)]">
    <p>© {new Date().getFullYear()} {profile.name}. Built with Astro, Tailwind & Claude.</p>
    <p>
      Source:
      <a href="https://github.com/enaguero/cv-bytebytego" class="underline hover:text-white" target="_blank" rel="noopener">
        github.com/enaguero/cv-bytebytego
      </a>
    </p>
  </footer>
</section>
