---
import { teachingArtifacts, howITeach } from "~/data/cv";
---

<section id="artifacts" class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
  <div class="max-w-3xl">
    <p class="section-title">Things to look at</p>
    <h2 class="mt-2 text-3xl sm:text-4xl font-semibold tracking-tight">
      Concrete teaching artifacts.
    </h2>
    <p class="mt-4 text-[color:var(--color-text-muted)] leading-relaxed">
      Three pieces of evidence, each linked. Not a portfolio of polished
      products — actual repos, reviews and notes from teaching.
    </p>
  </div>

  <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {
      teachingArtifacts.map((a) => (
        <a
          href={a.link}
          target={a.link.startsWith("http") ? "_blank" : "_self"}
          rel="noopener"
          class="group flex flex-col rounded-2xl border border-[color:var(--color-border)] bg-[color:var(--color-surface)]/70 p-6 backdrop-blur transition hover:border-[color:var(--color-accent)]/60 hover:bg-[color:var(--color-surface-2)]/70"
        >
          <div class="flex items-start justify-between gap-3">
            <h3 class="text-lg font-semibold leading-snug group-hover:text-[color:var(--color-accent)] transition">
              {a.title}
            </h3>
          </div>
          <p class="mt-2 text-xs uppercase tracking-widest text-[color:var(--color-accent-warm)]">
            {a.role}
          </p>
          <p class="mt-3 text-sm leading-relaxed text-[color:var(--color-text-muted)]">
            {a.description}
          </p>
          <blockquote class="mt-4 border-l-2 border-[color:var(--color-accent-warm)]/50 pl-3 text-sm italic text-[color:var(--color-text)]">
            “{a.quote}”
          </blockquote>
          <div class="mt-4 flex flex-wrap gap-2">
            {a.metrics.map((m) => (
              <span class="chip">{m}</span>
            ))}
          </div>
          <p class="mt-auto pt-4 font-mono text-xs text-[color:var(--color-text-muted)]">
            <span class="text-[color:var(--color-accent-2)]">↗</span>{" "}
            {a.link.replace("https://", "")}
          </p>
        </a>
      ))
    }
  </div>

  <!-- How I teach — softened from "philosophy" -->
  <div class="mt-12 rounded-2xl border border-[color:var(--color-border)] bg-[color:var(--color-bg-soft)]/70 p-6 sm:p-8">
    <p class="section-title">How I try to teach</p>
    <ul class="mt-5 grid gap-5 sm:grid-cols-2">
      {
        howITeach.map((h, i) => (
          <li class="flex gap-4">
            <span class="mt-0.5 font-mono text-sm text-[color:var(--color-accent-warm)] shrink-0">
              0{i + 1}
            </span>
            <div>
              <p class="font-medium text-[color:var(--color-text)]">{h.title}</p>
              <p class="mt-1 text-sm text-[color:var(--color-text-muted)] leading-relaxed">
                {h.body}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
