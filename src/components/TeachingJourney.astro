---
import { teachingJourney } from "~/data/cv";
---

<section id="journey" class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
  <div class="max-w-3xl">
    <p class="section-title">The teaching arc</p>
    <h2 class="mt-2 text-3xl sm:text-4xl font-semibold tracking-tight">
      How I got here.
    </h2>
    <p class="mt-4 text-[color:var(--color-text-muted)] leading-relaxed">
      Teaching has never been a side project for me — it has been a parallel
      craft that I've kept returning to, alongside engineering, since
      university. The bi-weekly cadence at ByteByteGo would let me keep going.
    </p>
  </div>

  <ol class="relative mt-12 border-l border-[color:var(--color-border)] pl-6 sm:pl-10 space-y-10">
    {
      teachingJourney.map((step, i) => (
        <li class="relative">
          <span
            class="absolute -left-[34px] sm:-left-[46px] mt-1 flex size-5 items-center justify-center rounded-full border border-[color:var(--color-border)] bg-[color:var(--color-surface)] font-mono text-[10px] text-[color:var(--color-accent-warm)]"
            aria-hidden="true"
          >
            {String(i + 1).padStart(2, "0")}
          </span>
          <p class="text-xs uppercase tracking-widest text-[color:var(--color-accent-warm)]">
            {step.period}
          </p>
          <h3 class="mt-1 text-lg sm:text-xl font-semibold leading-snug">
            {step.role} <span class="text-[color:var(--color-text-muted)] font-normal">· {step.where}</span>
          </h3>
          <p class="mt-3 max-w-3xl text-[color:var(--color-text-muted)] leading-relaxed">
            {step.body}
          </p>
          {step.link && (
            <a
              href={step.link.href}
              target="_blank"
              rel="noopener"
              class="mt-3 inline-flex items-center gap-1 text-sm text-[color:var(--color-accent-2)] hover:text-white transition"
            >
              {step.link.label}
              <span aria-hidden="true">↗</span>
            </a>
          )}
        </li>
      ))
    }
  </ol>
</section>
