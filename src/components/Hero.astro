---
import { profile } from "~/data/cv";

const mailto = `mailto:jobs@bytebytego.com?subject=${encodeURIComponent(
  "Part-Time Instructor Application — Erwin Aguero",
)}&body=${encodeURIComponent(
  "Hi ByteByteGo team,\n\nI'd love to be considered for the part-time instructor role. My one-page application with live AI demo is here: https://YOUR-DEPLOYED-URL\n\nQuick context:\n- Currently teaching a 29-day full-stack cohort at 4Geeks Academy Spain\n- Excited to teach: System Design, Agentic AI Coding, AI Automation\n- The CV site itself is a deployed Astro app with a Claude-powered chat — built end-to-end as live evidence for the AI tracks\n\nHappy to send writing/teaching samples and jump on a call.\n\n— Erwin\n",
)}`;
---

<header class="relative overflow-hidden">
  <div class="grid-bg absolute inset-0 -z-10"></div>

  <div class="mx-auto max-w-6xl px-6 pt-16 pb-12 sm:pt-24 sm:pb-20">
    <div class="flex items-center gap-3 text-xs text-[color:var(--color-text-muted)]">
      <span class="chip">
        <span class="size-1.5 rounded-full bg-[color:var(--color-accent)] inline-block"></span>
        Available · 2–5 hrs / bi-weekly
      </span>
      <span class="chip">Spain · CET</span>
      <a class="chip hover:text-white transition" href={profile.github} target="_blank" rel="noopener">
        @{profile.handle}
      </a>
    </div>

    <h1 class="mt-6 text-4xl sm:text-6xl font-bold tracking-tight leading-[1.05]">
      <span class="block">{profile.name}.</span>
      <span class="block bg-gradient-to-r from-[color:var(--color-accent)] via-[color:var(--color-accent-2)] to-[color:var(--color-accent-3)] bg-clip-text text-transparent">
        Engineer who teaches.
      </span>
      <span class="block">Teacher who ships.</span>
    </h1>

    <p class="mt-6 max-w-2xl text-lg text-[color:var(--color-text-muted)] leading-relaxed">
      {profile.pitch}
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a class="cta-primary" href={mailto}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 6h16v12H4z"/>
          <path d="m4 7 8 6 8-6"/>
        </svg>
        Email jobs@bytebytego.com
      </a>
      <a class="cta-secondary" href="#ask">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
        </svg>
        Ask my CV anything
      </a>
      <a class="cta-secondary" href="#tracks">
        See the tracks
      </a>
    </div>

    <!-- Meta callout: the site itself as evidence -->
    <div class="mt-12 max-w-3xl rounded-xl border border-[color:var(--color-border)] bg-[color:var(--color-surface)]/60 backdrop-blur p-5 glow-border">
      <p class="section-title">This page is the portfolio</p>
      <p class="mt-2 text-[color:var(--color-text)]">
        Astro + Tailwind + a Vercel serverless function calling Claude.
        Built collaboratively with Claude Code, auto-deployed from GitHub on every push.
        The chat below isn't a screenshot — it's a live production AI integration.
      </p>
      <div class="mt-3 flex flex-wrap gap-2 text-xs">
        <span class="chip">Astro 5</span>
        <span class="chip">Tailwind 4</span>
        <span class="chip">Claude Sonnet 4.6</span>
        <span class="chip">Vercel</span>
        <span class="chip">GitHub CI/CD</span>
      </div>
    </div>
  </div>
</header>
