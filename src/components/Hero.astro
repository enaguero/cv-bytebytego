---
import { profile } from "~/data/cv";

const mailto = `mailto:${profile.email}?subject=${encodeURIComponent(
  "Hi Erwin",
)}`;
---

<header class="relative overflow-hidden">
  <div class="grid-bg absolute inset-0 -z-10"></div>

  <div class="mx-auto max-w-6xl px-6 pt-16 pb-12 sm:pt-24 sm:pb-20">
    <div class="flex flex-wrap items-center gap-3 text-xs text-[color:var(--color-text-muted)]">
      <span class="chip">
        <span class="size-1.5 rounded-full bg-[color:var(--color-accent)] inline-block"></span>
        Open to 2–5 hrs / bi-weekly
      </span>
      <span class="chip">Chilean · based in London · GMT</span>
      <a class="chip hover:text-white transition" href={profile.github} target="_blank" rel="noopener">
        github · @{profile.handle}
      </a>
      <a class="chip hover:text-white transition" href={profile.linkedin} target="_blank" rel="noopener">
        linkedin · /in/{profile.handle}
      </a>
    </div>

    <h1 class="mt-6 text-4xl sm:text-5xl font-semibold tracking-tight leading-[1.1]">
      <span class="block text-[color:var(--color-text)]">Hi, I'm {profile.name}.</span>
      <span class="block mt-2 text-[color:var(--color-text-muted)] font-normal text-2xl sm:text-3xl leading-snug">
        A Chilean software engineer based in London who has been teaching, in one form or another,
        <span class="text-[color:var(--color-accent-warm)]">for over a decade</span>.
      </span>
    </h1>

    <p class="mt-8 max-w-2xl text-lg text-[color:var(--color-text-muted)] leading-relaxed">
      {profile.pitch}
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a class="cta-primary" href={mailto}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 6h16v12H4z"/>
          <path d="m4 7 8 6 8-6"/>
        </svg>
        Email me
      </a>
      <a class="cta-secondary" href="#journey">
        How I got here
      </a>
      <a class="cta-secondary" href="/sample-review">
        Read a sample review I wrote
      </a>
    </div>

    <!-- Meta callout: the site itself, framed humbly -->
    <div class="mt-12 max-w-3xl rounded-xl border border-[color:var(--color-border)] bg-[color:var(--color-surface)]/60 backdrop-blur p-5">
      <p class="section-title">A small note about this page</p>
      <p class="mt-2 text-[color:var(--color-text)] leading-relaxed">
        I built this site in the open with Claude Code so you could see the kind of work
        I'd be teaching. The chat further down is a live Claude endpoint grounded in my CV —
        ask it anything; it will tell you when it doesn't know. The commits on GitHub are
        honest about what I prompted, what I rewrote, and where the agent went wrong.
      </p>
      <div class="mt-3 flex flex-wrap gap-2 text-xs">
        <span class="chip">Astro 5</span>
        <span class="chip">Tailwind 4</span>
        <span class="chip">Claude Sonnet 4.6</span>
        <span class="chip">Vercel</span>
      </div>
    </div>
  </div>
</header>
