---
import { tracks } from "~/data/cv";

const samplePrompts = [
  "What's Erwin's teaching journey?",
  "How would Erwin start the System Design track?",
  "What does he do when an agent goes off-rails?",
  "Where is he still learning?",
];
---

<section id="ask" class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
  <div class="grid gap-10 lg:grid-cols-5">
    <div class="lg:col-span-2">
      <p class="section-title">A small live demo</p>
      <h2 class="mt-2 text-3xl sm:text-4xl font-semibold tracking-tight">
        Ask my CV a question.
      </h2>
      <p class="mt-4 text-[color:var(--color-text-muted)] leading-relaxed">
        Rather than just describing the AI tracks, here is a tiny example: the
        chat on the right is a Vercel serverless function calling Claude with
        my CV as system context. It's the same pattern I'd use in lesson one of
        the Agentic AI track — small enough to read in one sitting.
      </p>

      <ul class="mt-6 space-y-2 text-sm">
        <li class="flex gap-2">
          <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-[color:var(--color-accent)]"></span>
          <span>About 50 lines of API code, readable in one sitting.</span>
        </li>
        <li class="flex gap-2">
          <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-[color:var(--color-accent-2)]"></span>
          <span>The same shape works for docs Q&amp;A, support bots, internal tools.</span>
        </li>
        <li class="flex gap-2">
          <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-[color:var(--color-accent-warm)]"></span>
          <span>Failure modes — rate limits, hallucination, latency — are part of the lesson, not edge cases.</span>
        </li>
      </ul>

      <p class="mt-6 text-xs text-[color:var(--color-text-muted)]">
        Try a sample:
      </p>
      <div class="mt-2 flex flex-wrap gap-2" id="sample-prompts">
        {
          samplePrompts.map((p) => (
            <button
              type="button"
              data-prompt={p}
              class="chip hover:text-white hover:border-[color:var(--color-accent-2)] transition cursor-pointer"
            >
              {p}
            </button>
          ))
        }
      </div>
    </div>

    <div class="lg:col-span-3">
      <div
        class="flex h-[520px] flex-col rounded-2xl border border-[color:var(--color-border)] bg-[color:var(--color-surface)]/80 backdrop-blur glow-border overflow-hidden"
      >
        <div class="flex items-center justify-between border-b border-[color:var(--color-border)] px-4 py-3">
          <div class="flex items-center gap-2">
            <span class="size-2 rounded-full bg-[color:var(--color-accent)] animate-pulse"></span>
            <span class="font-mono text-xs text-[color:var(--color-text-muted)]">
              POST /api/ask · claude-sonnet-4-6
            </span>
          </div>
          <button
            type="button"
            id="chat-clear"
            class="text-xs text-[color:var(--color-text-muted)] hover:text-white transition"
          >
            Clear
          </button>
        </div>

        <div
          id="chat-log"
          class="flex-1 overflow-y-auto px-4 py-4 flex flex-col gap-3"
          aria-live="polite"
        >
          <div class="chat-bubble chat-bubble-assistant">Hi! I'm a small Claude assistant grounded in Erwin's CV. Ask me about his teaching journey, the tracks he'd like to teach at ByteByteGo, or anything else from his background — and I'll be upfront when something is outside what I know.</div>
        </div>

        <form
          id="chat-form"
          class="border-t border-[color:var(--color-border)] p-3 flex gap-2"
        >
          <input
            id="chat-input"
            name="prompt"
            type="text"
            required
            maxlength="500"
            placeholder="Ask about Erwin..."
            class="flex-1 rounded-md bg-black/30 border border-[color:var(--color-border)] px-3 py-2 text-sm focus:outline-none focus:border-[color:var(--color-accent-2)]"
            autocomplete="off"
          />
          <button
            type="submit"
            id="chat-send"
            class="cta-primary text-sm !py-2 !px-4"
          >
            Send
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("chat-form") as HTMLFormElement;
  const input = document.getElementById("chat-input") as HTMLInputElement;
  const log = document.getElementById("chat-log") as HTMLDivElement;
  const clearBtn = document.getElementById("chat-clear") as HTMLButtonElement;
  const sendBtn = document.getElementById("chat-send") as HTMLButtonElement;
  const samples = document.getElementById("sample-prompts") as HTMLDivElement;

  const history: { role: "user" | "assistant"; content: string }[] = [];

  function addBubble(role: "user" | "assistant", text: string): HTMLDivElement {
    const div = document.createElement("div");
    div.className =
      "chat-bubble " +
      (role === "user" ? "chat-bubble-user" : "chat-bubble-assistant");
    div.textContent = text;
    log.appendChild(div);
    log.scrollTop = log.scrollHeight;
    return div;
  }

  function addTyping(): HTMLDivElement {
    const div = document.createElement("div");
    div.className = "chat-bubble chat-bubble-assistant";
    div.innerHTML =
      '<span class="typing-dot"></span><span class="typing-dot"></span><span class="typing-dot"></span>';
    log.appendChild(div);
    log.scrollTop = log.scrollHeight;
    return div;
  }

  async function send(prompt: string) {
    if (!prompt.trim()) return;
    input.value = "";
    addBubble("user", prompt);
    history.push({ role: "user", content: prompt });
    const typing = addTyping();
    sendBtn.disabled = true;

    try {
      const res = await fetch("/api/ask", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ messages: history }),
      });

      if (!res.ok) {
        const err = await res.json().catch(() => ({}));
        typing.textContent =
          err.error ??
          "Something went wrong calling the API. Check the README for setup.";
        typing.classList.add("text-red-300");
        return;
      }

      const data = await res.json();
      const reply = data.reply ?? "(no reply)";
      typing.textContent = reply;
      history.push({ role: "assistant", content: reply });
    } catch (e) {
      typing.textContent =
        "Network error. The API might not be deployed yet — see README.";
      typing.classList.add("text-red-300");
    } finally {
      sendBtn.disabled = false;
      input.focus();
    }
  }

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    void send(input.value);
  });

  clearBtn.addEventListener("click", () => {
    history.length = 0;
    log.innerHTML = "";
    addBubble(
      "assistant",
      "Cleared. Ask away — I'm grounded in Erwin's CV and will say when I don't know.",
    );
  });

  samples.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    const btn = target.closest<HTMLButtonElement>("button[data-prompt]");
    if (!btn) return;
    void send(btn.dataset.prompt ?? "");
  });
</script>
